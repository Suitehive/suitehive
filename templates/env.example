# Suitehive: installation settings (<install dir>/.env)
#
# `suitehive install` writes this file for you (mode 600) and generates every
# secret, so you rarely need to write it by hand. This copy documents every key.
# docker compose reads it automatically from the install directory; both
# docker-compose.yml and Caddyfile get their values from here.
#
# Keep it private: it holds the master encryption key and the database password.
# Losing SH_MASTER_KEY makes encrypted data (keys, TOTP secrets, tokens)
# unrecoverable, so back it up (`suitehive backup` includes it).
#
# Syntax: KEY=value, one per line, no spaces around "=". Quote values that
# contain spaces with double quotes.

# ---------------------------------------------------------------- release
# Image tag for ghcr.io/suitehive/{auth,mail,calendar}. "edge" follows main;
# pin a release such as 0.1.0 for production. `suitehive upgrade --version X`
# changes it for you.
SH_VERSION=edge

# ---------------------------------------------------------------- identity
# Your first mail domain: addresses look like you@example.com.
SH_DOMAIN=example.com
# Public hostname of the suite (web, IMAP, SMTP, CalDAV). It needs an A/AAAA
# record pointing at this server. Default: suite.<SH_DOMAIN>.
SH_HOSTNAME=suite.example.com
# Base URL that users and OIDC clients see. Also the OIDC issuer.
SH_PUBLIC_URL=https://suite.example.com
# What Caddy serves: the hostname (automatic HTTPS) or ":80" (plain HTTP, for a
# local trial or when another proxy terminates TLS in front of Caddy).
SH_SITE_ADDRESS=suite.example.com
# Email for the ACME (Let's Encrypt) account: certificate expiry notices.
SH_TLS_EMAIL=admin@example.com

# Informational: what `suitehive install` used for first-time setup. Changing
# them later has no effect; use Admin -> Organization instead.
SH_ORG_NAME="Example"
SH_ORG_SLUG=example
SH_ADMIN_EMAIL=admin@example.com
SH_ADMIN_NAME="Admin"

# Domain-ownership TXT record returned by first-time setup (shown by
# `suitehive dns`). Filled in automatically.
#SH_VERIFY_TXT_NAME=_suitehive.example.com
#SH_VERIFY_TXT_VALUE=suitehive-verification=...

# ---------------------------------------------------------------- system email
# How Auth sends its own email (invitations, password resets). It uses plain SMTP
# submission, so it never depends on the Mail service's API. Both are optional:
# the defaults use Suitehive Mail and no-reply@<SH_DOMAIN>. Any SMTP relay works,
# e.g. smtp://user:password@smtp.example.net:587.
#SH_EMAIL_SMTP_URL=smtp://mail:587
#SH_EMAIL_FROM="Suitehive <no-reply@example.com>"

# ---------------------------------------------------------------- mode
# true = local trial (`install --local`): plain HTTP on localhost, demo data.
SH_LOCAL=false
# true = images are built from source in ./src (`install --build`).
SH_BUILD=false

# ---------------------------------------------------------------- ports
# Host ports. The defaults are the standard ones; a local trial remaps them to
# unprivileged ports (8080, 8443, 2525, 2465, 2587, 1993).
SH_HTTP_PORT=80
SH_HTTPS_PORT=443
SH_SMTP_PORT=25
SH_SMTPS_PORT=465
SH_SUBMISSION_PORT=587
SH_IMAPS_PORT=993
# Auth's HTTP port, published on 127.0.0.1 only, for the CLI (health, setup).
SH_AUTH_LOCAL_PORT=8081

# ---------------------------------------------------------------- dev flags
# Seed the demo org (domain suitehive.local, users admin@/priya@/alex@,
# password suitehive-dev). Never enable it on a public server.
SH_DEV_SEED=false
# Use non-__Host- cookies so sign-in works over plain http://localhost.
SH_DEV_INSECURE_COOKIES=false
# debug | info | warn | error
SH_LOG_LEVEL=info

# ---------------------------------------------------------------- secrets
# Generated at install time. Do not change them on a running installation:
# SH_POSTGRES_PASSWORD is applied when the database volume is created, and
# SH_MASTER_KEY encrypts data at rest.
# 32 random bytes, base64 (openssl rand -base64 32).
SH_MASTER_KEY=
# Letters and digits only (it is embedded in database URLs).
SH_POSTGRES_PASSWORD=
# Client-credentials secrets of the svc:mail and svc:calendar service clients
# (service-to-service calls to Auth).
SH_MAIL_CLIENT_SECRET=
SH_CALENDAR_CLIENT_SECRET=

# The first admin's password is never stored here. `suitehive install` shows it
# once (or uses --admin-password / SH_ADMIN_PASSWORD).
