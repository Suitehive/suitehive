#!/usr/bin/env bash
#
# suitehive: install and operate a self-hosted Suitehive
# (Mail, Calendar, and shared sign-in/admin) with docker compose.
#
#   suitehive install [--domain example.com]   set up a new server (or --local trial)
#   suitehive status | logs | dns              look at a running install
#   suitehive upgrade | backup | restore       day-2 operations
#   suitehive uninstall | version | help
#
# Run `suitehive help <command>` for details on each command.
#
# How this script is organized (read it before you run it, it's meant for that):
#   1. constants
#   2. output helpers (colors only on a TTY and when NO_COLOR is unset)
#   3. generic helpers: prompts, .env access, downloads, secrets, JSON, compose
#   4. checks (docker, memory, ports)
#   5. one cmd_<name> + help_<name> per command
#   6. main: global options and dispatch
#
# Everything an install needs lives in one directory (default /opt/suitehive as
# root, ~/suitehive otherwise): .env (settings + secrets, mode 600),
# docker-compose.yml, Caddyfile, initdb/, backups/ and, for --build, src/.
# The CLI finds it via --dir, $SH_DIR, ./.env in the current directory, or the
# default location, in that order.
#
# Runs on bash 3.2+ (macOS default) and needs docker with compose v2, curl (or
# wget), openssl (or base64), tar and gzip.

set -euo pipefail

# ============================================================== 1. constants ==

SUITEHIVE_CLI_VERSION="0.1.0-dev"

# Default image tag for ghcr.io/suitehive/*: "edge" tracks main. Pin a release
# with `install --version 0.1.0` / `upgrade --version 0.1.0`.
DEFAULT_IMAGE_TAG="edge"
# Tag given to locally built images (--build) unless --version is passed.
BUILD_IMAGE_TAG="local"

# Where templates are downloaded from when not running from a clone.
REPO_RAW="${SH_REPO_RAW:-https://raw.githubusercontent.com/Suitehive/suitehive/${SH_REF:-main}}"
# Where --build clones the service repositories from.
GIT_BASE="${SH_GIT_BASE:-https://github.com/Suitehive}"

ALL_SERVICES="caddy postgres nats auth mail calendar"
APP_SERVICES="auth mail calendar"
INFRA_SERVICES="caddy postgres nats"
BUILD_REPOS="kit contracts ui auth mail calendar"
DATABASES="suitehive_auth suitehive_mail suitehive_calendar"

# Demo data seeded in --local mode (SH_DEV_SEED=true).
DEMO_DOMAIN="suitehive.local"
DEMO_PASSWORD="suitehive-dev"
DEMO_USERS="admin priya alex"

# Seconds to wait for auth's /healthz after `docker compose up`.
HEALTH_TIMEOUT="${SH_HEALTH_TIMEOUT:-180}"
# 4 GB is the documented minimum. A "4 GB" VPS reports a bit less than 4 GiB of
# MemTotal (kernel reservations), so the hard limit is 3.5 GiB.
MIN_MEM_KB=3670016

# Every key the CLI manages in .env. Lines with other keys are preserved as-is
# when install rewrites the file.
KNOWN_ENV_KEYS="SH_VERSION SH_DOMAIN SH_HOSTNAME SH_PUBLIC_URL SH_SITE_ADDRESS SH_TLS_EMAIL
SH_ORG_NAME SH_ORG_SLUG SH_ADMIN_EMAIL SH_ADMIN_NAME SH_VERIFY_TXT_NAME SH_VERIFY_TXT_VALUE
SH_LOCAL SH_BUILD SH_HTTP_PORT SH_HTTPS_PORT SH_SMTP_PORT SH_SMTPS_PORT SH_SUBMISSION_PORT
SH_IMAPS_PORT SH_AUTH_LOCAL_PORT SH_DEV_SEED SH_DEV_INSECURE_COOKIES SH_LOG_LEVEL
SH_MASTER_KEY SH_POSTGRES_PASSWORD SH_MAIL_CLIENT_SECRET SH_CALENDAR_CLIENT_SECRET"

# Set by option parsing.
DIR=""            # resolved install directory (absolute)
OPT_DIR=""        # --dir
ASSUME_YES=0      # --yes
DRY_RUN=0         # --dry-run
TTY_READY=""      # cached result of tty_ready
CLEANUP_PATHS=""  # temp paths removed on exit (newline-separated)

# ======================================================== 2. output helpers ==

setup_output() {
  if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]]; then
    C_BOLD=$'\033[1m' C_DIM=$'\033[2m' C_RED=$'\033[31m' C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m' C_CYAN=$'\033[36m' C_RESET=$'\033[0m'
  else
    C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE="" C_CYAN="" C_RESET=""
  fi
  # Unicode marks only when the locale can display them.
  case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
    *[Uu][Tt][Ff]-8* | *[Uu][Tt][Ff]8*) G_OK="✓" G_BAD="✗" G_NE="≠" G_WAIT="…" ;;
    *) G_OK="+" G_BAD="x" G_NE="!=" G_WAIT="..." ;;
  esac
}

header() { printf '%s%s%s\n' "$C_BOLD" "$*" "$C_RESET"; }
step() { printf '%s==>%s %s%s%s\n' "$C_BLUE" "$C_RESET" "$C_BOLD" "$*" "$C_RESET"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '    %s%s%s %s\n' "$C_GREEN" "$G_OK" "$C_RESET" "$*"; }
note() { printf '    %s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
warn() { printf '%swarning:%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
die() {
  printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2
  exit 1
}
# kv <label> <value>: one aligned summary line.
kv() { printf '  %-13s %s\n' "$1" "$2"; }
dry() { printf '    %s[dry-run]%s %s\n' "$C_DIM" "$C_RESET" "$*"; }

# quote_args <args...>: render a command line that can be pasted into a shell.
quote_args() {
  local out="" a re='^[A-Za-z0-9_./:=@%+,-]+$'
  for a in "$@"; do
    if [[ $a =~ $re ]]; then
      out="$out$a "
    else
      out="$out'${a//\'/\'\\\'\'}' "
    fi
  done
  printf '%s' "${out% }"
}

# ======================================================= 3. generic helpers ==

have() { command -v "$1" >/dev/null 2>&1; }

cleanup() {
  local p
  if [[ -n $CLEANUP_PATHS ]]; then
    while IFS= read -r p; do
      [[ -n $p ]] && rm -rf "$p" 2>/dev/null || true
    done <<<"$CLEANUP_PATHS"
  fi
}
trap cleanup EXIT
on_exit_remove() { CLEANUP_PATHS="$CLEANUP_PATHS"$'\n'"$1"; }

# need_value <option> <remaining args...>: options that take a value.
need_value() {
  [[ $# -ge 2 && -n ${2:-} ]] || die "$1 needs a value (see --help)"
}

# pick <values...>: print the first non-empty argument.
pick() {
  local v
  for v in "$@"; do
    if [[ -n $v ]]; then
      printf '%s' "$v"
      return 0
    fi
  done
}

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# script_dir: directory of this script, following symlinks (no readlink -f on
# older macOS).
script_dir() {
  local src=${BASH_SOURCE[0]} dir
  while [[ -L $src ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    if [[ $src != /* ]]; then src=$dir/$src; fi
  done
  cd -P "$(dirname "$src")" && pwd
}

# abs_path <path>: absolute path, without requiring it to exist.
abs_path() {
  local p=$1
  case $p in
    "~") p=$HOME ;;
    "~/"*) p=$HOME/${p#"~/"} ;;
  esac
  if [[ -d $p ]]; then
    (cd "$p" && pwd)
  elif [[ $p == /* || $p =~ ^[A-Za-z]:[/\\] ]]; then # (drive letters: Git Bash/WSL interop)
    printf '%s' "${p%/}"
  else
    printf '%s/%s' "$PWD" "${p%/}"
  fi
}

# ------------------------------------------------------------------ prompts --

# tty_ready: true when we may ask questions. Works under `curl ... | sh` too:
# stdin is the pipe then, so questions are read from /dev/tty (fd 3).
tty_ready() {
  if [[ -z $TTY_READY ]]; then
    TTY_READY=no
    if [[ $ASSUME_YES != 1 ]]; then
      if [[ -t 0 ]]; then
        exec 3<&0
        TTY_READY=yes
      elif { exec 3</dev/tty; } 2>/dev/null; then
        TTY_READY=yes
      fi
    fi
  fi
  [[ $TTY_READY == yes ]]
}

# ask <var> <question> [default]: sets <var> to the answer, or the default when
# the answer is empty or we cannot ask.
ask() {
  local __var=$1 __q=$2 __def=${3:-} __ans=""
  if tty_ready; then
    if [[ -n $__def ]]; then
      printf '%s?%s %s %s[%s]%s: ' "$C_CYAN" "$C_RESET" "$__q" "$C_DIM" "$__def" "$C_RESET" >&2
    else
      printf '%s?%s %s: ' "$C_CYAN" "$C_RESET" "$__q" >&2
    fi
    IFS= read -r __ans <&3 || __ans=""
  fi
  printf -v "$__var" '%s' "${__ans:-$__def}"
}

# ask_secret <var> <question>: like ask, without echo and without a default.
ask_secret() {
  local __var=$1 __q=$2 __ans=""
  if tty_ready; then
    printf '%s?%s %s: ' "$C_CYAN" "$C_RESET" "$__q" >&2
    IFS= read -rs __ans <&3 || __ans=""
    printf '\n' >&2
  fi
  printf -v "$__var" '%s' "$__ans"
}

# confirm <question> <y|n>: yes/no question. --yes answers yes; without a
# terminal the default is used.
confirm() {
  local q=$1 def=${2:-n} ans hint
  if [[ $ASSUME_YES == 1 ]]; then return 0; fi
  if ! tty_ready; then
    if [[ $def == y ]]; then return 0; else return 1; fi
  fi
  if [[ $def == y ]]; then hint="Y/n"; else hint="y/N"; fi
  printf '%s?%s %s [%s] ' "$C_CYAN" "$C_RESET" "$q" "$hint" >&2
  IFS= read -r ans <&3 || ans=""
  ans=$(lower "${ans:-$def}")
  [[ $ans == y || $ans == yes ]]
}

# confirm_typed <expected> <message>: destructive actions. The user must type
# <expected> (the domain) unless --yes was given.
confirm_typed() {
  local expected=$1 msg=$2 ans=""
  if [[ $ASSUME_YES == 1 ]]; then return 0; fi
  tty_ready || die "$msg. Re-run with --yes to confirm without a terminal."
  printf '%s%s%s\n' "$C_YELLOW" "$msg" "$C_RESET" >&2
  printf '%s?%s Type %s%s%s to confirm: ' "$C_CYAN" "$C_RESET" "$C_BOLD" "$expected" "$C_RESET" >&2
  IFS= read -r ans <&3 || ans=""
  [[ $ans == "$expected" ]] || die "confirmation did not match; nothing was changed"
}

# -------------------------------------------------------- install directory --

default_dir() {
  if [[ $(id -u) == 0 ]]; then printf '/opt/suitehive'; else printf '%s/suitehive' "$HOME"; fi
}

# resolve_dir: --dir, $SH_DIR, an install in the current directory, default.
resolve_dir() {
  if [[ -n $OPT_DIR ]]; then
    DIR=$OPT_DIR
  elif [[ -n ${SH_DIR:-} ]]; then
    DIR=$SH_DIR
  elif [[ -f ./.env && -f ./docker-compose.yml ]] && grep -q '^SH_DOMAIN=' ./.env 2>/dev/null; then
    DIR=$PWD
  else
    DIR=$(default_dir)
  fi
  DIR=$(abs_path "$DIR")
}

# require_install: the commands other than install need an existing install.
require_install() {
  resolve_dir
  [[ -f $DIR/.env ]] || die "no Suitehive install found in $DIR
       Use --dir <path> or set SH_DIR (or run \`suitehive install\` first)."
  [[ -f $DIR/docker-compose.yml ]] || die "$DIR/docker-compose.yml is missing; run \`suitehive upgrade\` to restore it"
  load_settings
}

# ---------------------------------------------------------------- .env I/O --

# env_get <KEY> [file]: value of KEY in a dotenv file (quotes removed).
env_get() {
  local key=$1 file=${2:-$DIR/.env} line
  [[ -f $file ]] || return 1
  line=$(grep -E "^${key}=" "$file" | tail -n 1) || return 1
  line=${line#*=}
  line=${line%$'\r'}
  if [[ ${#line} -ge 2 && $line == \"*\" ]]; then
    line=${line:1:${#line}-2}
  elif [[ ${#line} -ge 2 && $line == \'*\' ]]; then
    line=${line:1:${#line}-2}
  fi
  printf '%s' "$line"
}

# prev <KEY>: value from the existing .env, or nothing.
prev() { env_get "$1" 2>/dev/null || true; }

# env_set <KEY> <value>: replace or append KEY in .env, keeping mode 600.
env_set() {
  local key=$1 val file=$DIR/.env tmp
  val=$(env_quote "$2")
  tmp=$(mktemp "$DIR/.env.XXXXXX")
  K="$key" V="$val" awk '
    BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"]; done = 0 }
    index($0, k "=") == 1 { if (!done) print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$file" >"$tmp"
  chmod 600 "$tmp"
  mv -f "$tmp" "$file"
}

# env_quote <value>: dotenv-safe value. Simple values stay bare; anything else
# is double-quoted with characters that docker compose would interpret ($, ",
# \, `) removed. Only free-text fields (names) ever need this.
env_quote() {
  local v=$1 re='^[A-Za-z0-9._@:/+=,-]*$'
  if [[ $v =~ $re ]]; then
    printf '%s' "$v"
  else
    v=$(printf '%s' "$v" | tr -d '"$\\`' | tr -d '\000-\037')
    printf '"%s"' "$v"
  fi
}

# load_settings: read the install's settings into globals.
load_settings() {
  DOMAIN=$(prev SH_DOMAIN)
  SITE_HOST=$(prev SH_HOSTNAME)
  PUBLIC_URL=$(prev SH_PUBLIC_URL)
  IMAGE_TAG=$(pick "$(prev SH_VERSION)" "$DEFAULT_IMAGE_TAG")
  LOCAL=$(pick "$(prev SH_LOCAL)" false)
  BUILD=$(pick "$(prev SH_BUILD)" false)
  AUTH_PORT=$(pick "$(prev SH_AUTH_LOCAL_PORT)" 8081)
  ADMIN_EMAIL=$(prev SH_ADMIN_EMAIL)
  VERIFY_NAME=$(prev SH_VERIFY_TXT_NAME)
  VERIFY_VALUE=$(prev SH_VERIFY_TXT_VALUE)
}

# ------------------------------------------------------------- downloads --

# download <url> <dest>: fetch to a temp file, then move into place.
download() {
  local url=$1 dest=$2 tmp="$2.part.$$"
  if have curl; then
    curl -fsSL --retry 2 --connect-timeout 10 -o "$tmp" "$url" || {
      rm -f "$tmp"
      die "download failed: $url"
    }
  elif have wget; then
    wget -q -T 20 -O "$tmp" "$url" || {
      rm -f "$tmp"
      die "download failed: $url"
    }
  else
    die "curl or wget is required to download $url"
  fi
  mv -f "$tmp" "$dest"
}

# Templates ship next to this script in a clone (../templates); otherwise they
# are downloaded from $REPO_RAW. SH_TEMPLATES_DIR overrides both.
templates_dir() {
  if [[ -n ${SH_TEMPLATES_DIR:-} ]]; then
    printf '%s' "$SH_TEMPLATES_DIR"
  else
    printf '%s/../templates' "$(script_dir)"
  fi
}

templates_source() {
  local t
  t=$(templates_dir)
  if [[ -f $t/docker-compose.yml ]]; then (cd "$t" && pwd); else printf '%s/templates' "$REPO_RAW"; fi
}

# fetch_template <relpath> <dest>: install one template file. A changed existing
# file is kept as <dest>.bak.
fetch_template() {
  local rel=$1 dest=$2 src new
  src="$(templates_dir)/$rel"
  new="$dest.new.$$"
  mkdir -p "$(dirname "$dest")"
  if [[ -f $src ]]; then
    cp "$src" "$new"
  else
    download "$REPO_RAW/templates/$rel" "$new"
  fi
  [[ -s $new ]] || {
    rm -f "$new"
    die "template $rel is empty"
  }
  if [[ -f $dest ]] && [[ "$(cat "$dest")" != "$(cat "$new")" ]]; then
    cp -p "$dest" "$dest.bak"
    note "updated $(basename "$dest") (previous version kept as $(basename "$dest").bak)"
  fi
  mv -f "$new" "$dest"
}

# install_templates: the compose stack files (not .env).
install_templates() {
  fetch_template docker-compose.yml "$DIR/docker-compose.yml"
  fetch_template Caddyfile "$DIR/Caddyfile"
  fetch_template initdb/01-databases.sql "$DIR/initdb/01-databases.sql"
  if [[ $BUILD == true ]]; then
    fetch_template docker-compose.build.yml "$DIR/docker-compose.build.yml"
  fi
}

# --------------------------------------------------------------- secrets --

# rand_b64 <nbytes>: random bytes, base64 (standard alphabet, one line).
rand_b64() {
  if have openssl; then
    openssl rand -base64 "$1" | tr -d '\n'
  elif [[ -r /dev/urandom ]] && have base64; then
    head -c "$1" /dev/urandom | base64 | tr -d '\n'
  else
    die "need openssl or base64 + /dev/urandom to generate secrets"
  fi
}

# rand_alnum <len>: letters and digits only (safe inside URLs and .env).
rand_alnum() {
  local out=""
  while [[ ${#out} -lt $1 ]]; do
    out="$out$(rand_b64 $(($1 * 2)) | tr -dc 'A-Za-z0-9')"
  done
  printf '%s' "${out:0:$1}"
}

# rand_password: 24 URL-safe characters (~143 bits).
rand_password() {
  local out=""
  while [[ ${#out} -lt 24 ]]; do
    out="$out$(rand_b64 24 | tr '+/' '-_' | tr -d '=')"
  done
  printf '%s' "${out:0:24}"
}

# ------------------------------------------------------------------ JSON --

# json_escape <string>: JSON string body (no surrounding quotes).
json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\000-\037'
}

# json_str <file> <jq-path> <key>: a string field. Uses jq when available; the
# sed fallback returns the first "key":"value" in the document.
json_str() {
  local file=$1 path=$2 key=$3
  if have jq; then
    jq -r "($path) // empty" "$file" 2>/dev/null || true
  else
    tr -d '\n' <"$file" | sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p'
  fi
}

# json_true <file> <key>: true when "key": true appears.
json_true() { grep -Eq "\"$1\"[[:space:]]*:[[:space:]]*true" "$2"; }

# --------------------------------------------------------- docker compose --

# compose <args...>: docker compose for this install. .env is the single source
# of truth, so SH_* variables from the caller's shell are removed first (compose
# would otherwise let them override .env).
compose() {
  local files
  files=(-f "$DIR/docker-compose.yml")
  if [[ $(prev SH_BUILD) == true && -f $DIR/docker-compose.build.yml ]]; then
    files=("${files[@]}" -f "$DIR/docker-compose.build.yml")
  fi
  (
    for v in $(compgen -v SH_ || true); do unset "$v" 2>/dev/null || true; done
    docker compose --project-directory "$DIR" "${files[@]}" "$@"
  )
}

# compose_run <args...>: compose, or just print it with --dry-run.
compose_run() {
  if [[ $DRY_RUN == 1 ]]; then
    local f="-f $DIR/docker-compose.yml"
    if [[ $(prev SH_BUILD) == true ]]; then f="$f -f $DIR/docker-compose.build.yml"; fi
    dry "docker compose --project-directory $(quote_args "$DIR") $f $(quote_args "$@")"
  else
    compose "$@"
  fi
}

# run <cmd...>: run a non-compose command, or print it with --dry-run.
run() {
  if [[ $DRY_RUN == 1 ]]; then dry "$(quote_args "$@")"; else "$@"; fi
}

project_name() { pick "${COMPOSE_PROJECT_NAME:-}" "$(prev COMPOSE_PROJECT_NAME)" suitehive; }

# volume_name <volume>: the docker volume compose created for this project.
volume_name() {
  local p v
  p=$(project_name)
  v=$(docker volume ls -q --filter "label=com.docker.compose.project=$p" \
    --filter "label=com.docker.compose.volume=$1" 2>/dev/null | head -n 1)
  pick "$v" "${p}_$1"
}

stack_running() { [[ -n $(compose ps -q 2>/dev/null || true) ]]; }

# ------------------------------------------------------------------ HTTP --

http_ok() {
  if have curl; then
    curl -fsS -o /dev/null --max-time 3 "$1" 2>/dev/null
  else
    wget -q -O /dev/null -T 3 "$1" 2>/dev/null
  fi
}

# wait_for_auth: poll auth's loopback /healthz with a spinner (dots without a TTY).
wait_for_auth() {
  local url="http://127.0.0.1:$AUTH_PORT/healthz" frames='|/-\' i=0
  local deadline=$((SECONDS + HEALTH_TIMEOUT))
  if [[ $DRY_RUN == 1 ]]; then
    dry "wait up to ${HEALTH_TIMEOUT}s for $url"
    return 0
  fi
  printf '    waiting for auth (up to %ss) ' "$HEALTH_TIMEOUT"
  while [[ $SECONDS -lt $deadline ]]; do
    if http_ok "$url"; then
      if [[ -t 1 ]]; then printf '\b'; fi
      printf '%s%s%s ready\n' "$C_GREEN" "$G_OK" "$C_RESET"
      return 0
    fi
    if [[ -t 1 ]]; then
      printf '\b%s' "${frames:$i:1}"
      i=$(((i + 1) % 4))
      sleep 1
    else
      printf '.'
      sleep 3
    fi
  done
  if [[ -t 1 ]]; then printf '\b'; fi
  printf '%stimed out%s\n' "$C_RED" "$C_RESET"
  warn "auth did not become healthy within ${HEALTH_TIMEOUT}s."
  warn "Look at \`suitehive logs auth\` (and \`suitehive status\`), then re-run the command."
  return 1
}

# public_ips: best-effort public IPv4/IPv6 of this server for the DNS table.
# Override with SH_PUBLIC_IP / SH_PUBLIC_IP6 ("none" skips that address family).
public_ips() {
  IP4=${SH_PUBLIC_IP:-}
  IP6=${SH_PUBLIC_IP6:-}
  if have curl; then
    if [[ -z $IP4 ]]; then IP4=$(curl -4 -fsS --max-time 4 https://api.ipify.org 2>/dev/null || true); fi
    if [[ -z $IP6 ]]; then IP6=$(curl -6 -fsS --max-time 4 https://api6.ipify.org 2>/dev/null || true); fi
  fi
  [[ $IP4 == none ]] && IP4=""
  [[ $IP6 == none ]] && IP6=""
  [[ $IP4 =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || IP4=""
  [[ $IP6 == *:* && $IP6 =~ ^[0-9A-Fa-f:]+$ ]] || IP6=""
}

# ========================================================== 4. checks ==

docker_problem() { # <soft> <message...>
  local soft=$1
  shift
  if [[ $soft == soft ]]; then
    warn "$*"
  else
    die "$*"
  fi
}

# docker_reachable: the daemon answers. (`docker version` is much faster than
# `docker info` and is not affected by broken CLI plugins.)
docker_reachable() { [[ -n $(docker version --format '{{.Server.Version}}' 2>/dev/null || true) ]]; }

# check_docker [soft]: docker installed, daemon reachable, compose v2.
check_docker() {
  local soft=${1:-hard} os
  os=$(uname -s)
  if ! have docker; then
    if [[ $os == Darwin ]]; then
      docker_problem "$soft" "Docker is not installed.
       Install Docker Desktop (https://www.docker.com/products/docker-desktop/)
       or OrbStack (https://orbstack.dev), start it, and run this again."
    else
      docker_problem "$soft" "Docker is not installed.
       Install it with:  curl -fsSL https://get.docker.com | sh
       (see https://docs.docker.com/engine/install/), then run this again."
    fi
    return 0
  fi
  if ! docker_reachable; then
    if [[ $os == Darwin ]]; then
      docker_problem "$soft" "the Docker daemon is not reachable. Start Docker Desktop / OrbStack and try again."
    else
      docker_problem "$soft" "the Docker daemon is not reachable.
       Start it (sudo systemctl start docker), and either run as root or add
       your user to the docker group: sudo usermod -aG docker \"\$USER\" (then log in again)."
    fi
    return 0
  fi
  if ! docker compose version >/dev/null 2>&1; then
    if [[ $os == Darwin ]]; then
      docker_problem "$soft" "docker compose v2 is missing. Update Docker Desktop / OrbStack."
    else
      docker_problem "$soft" "docker compose v2 is missing (the old docker-compose v1 is not supported).
       Debian/Ubuntu: sudo apt-get install docker-compose-plugin
       Fedora/RHEL:   sudo dnf install docker-compose-plugin
       or reinstall Docker with: curl -fsSL https://get.docker.com | sh"
    fi
    return 0
  fi
  ok "docker $(docker version --format '{{.Server.Version}}' 2>/dev/null || echo '?'), compose $(docker compose version --short 2>/dev/null || echo 'v2')"
}

# mem_kb: total memory in KiB, or nothing when unknown.
mem_kb() {
  case $(uname -s) in
    Darwin) echo $(($(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024)) ;;
    *) awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || true ;;
  esac
}

# check_memory <local:true|false> <skip:0|1>
check_memory() {
  local kb gib
  kb=$(mem_kb)
  if [[ -z $kb || $kb == 0 ]]; then
    warn "could not determine total memory; Suitehive needs at least 4 GB"
    return 0
  fi
  gib=$(awk -v k="$kb" 'BEGIN { printf "%.1f", k / 1048576 }')
  if [[ $kb -ge $MIN_MEM_KB ]]; then
    ok "memory: ${gib} GiB"
  elif [[ $1 == true || $2 == 1 ]]; then
    warn "only ${gib} GiB of memory; Suitehive needs about 4 GB (continuing anyway)"
  else
    die "only ${gib} GiB of memory; Suitehive needs at least 4 GB.
       Use a bigger server, or pass --skip-checks to try anyway."
  fi
}

# listening_ports: every listening TCP port, one per line ("" + rc 2 if no tool).
# One awk handles ss, lsof and Linux/macOS/Windows netstat: the first field that
# looks like <address>:<port> or <address>.<port> is the local address.
listening_ports() {
  local raw
  if have ss; then
    raw=$(ss -ltn 2>/dev/null | tail -n +2)
  elif have lsof; then
    raw=$(lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | tail -n +2)
  elif have netstat; then
    raw=$(netstat -an 2>/dev/null | grep -i 'listen')
  else
    return 2
  fi
  printf '%s\n' "$raw" | awk '{
    for (i = 1; i <= NF; i++) if ($i ~ /[.:][0-9]+$/ && $i ~ /[.:*]/) {
      n = split($i, parts, /[.:]/); print parts[n]; break
    }
  }' | sort -u
}

# check_ports <ports...>: warn about ports that something already listens on.
check_ports() {
  local p taken="" listening
  listening=$(listening_ports) || {
    warn "cannot check ports (no ss, lsof or netstat)"
    return 0
  }
  for p in "$@"; do
    if printf '%s\n' "$listening" | grep -qx "$p"; then taken="$taken $p"; fi
  done
  if [[ -n $taken ]]; then
    warn "ports already in use:$taken. Stop whatever listens there (another web or mail server?), or 'docker compose up' will fail."
  else
    ok "ports free: $*"
  fi
}

